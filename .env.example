DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 可選：填入伺服器 ID 以快速註冊指令；不填則註冊為全域指令。
DISCORD_GUILD_ID=
# 必填：bot-toolbox 頻道 ID。新工具指令另允許已驗證的 MOD 在 mod-only 使用。
DISCORD_WALLET_CHANNEL_ID=
ALCHEMY_API_KEY=
DATABASE_URL=
# V2 deployment: explicit opt-in and PostgreSQL reference; uses only wallet_v2_* tables.
WALLET_V2_ENABLED=false
WALLET_V2_DATABASE_URL=
# 每日活動：預設關閉；僅限單一 Bot 實例。
DAILY_ENABLED=false
# Keep false until explicit release approval and permission verification.
DAILY_PUBLIC_ACTIVITY_ENABLED=false
DAILY_UNVERIFIED_ROLE_ID=
DAILY_SNAPSHOT_ENABLED=false
# Optional separate PostgreSQL used by the group-chat repeat-warning service.
# When omitted, the activity database must contain discord_repeat_incidents.
DAILY_INCIDENT_DATABASE_URL=
DAILY_GUILD_ID=
DAILY_CHANNEL_ID=
DAILY_MOD_CHANNEL_ID=
DAILY_GROUP_CATEGORY_ID=
DAILY_GROUP_CHANNEL_IDS=
DAILY_MODERATOR_ROLE_ID=
DAILY_BOT_ROLE_ID=
# 僅允許這個機器人成員檢視私人活動頻道。
DAILY_GIVEAWAY_BOAT_ID=530082442967646230
# 資格串接僅限一位指定測試者；不得以此設定對一般成員開放。
DAILY_GIVEAWAY_TEST_ENABLED=false
# General-member bridge remains off until the private implementation is accepted.
DAILY_GIVEAWAY_ENABLED=false
DAILY_GIVEAWAY_ROLE_ID=
DAILY_GIVEAWAY_TEST_USER_ID=
