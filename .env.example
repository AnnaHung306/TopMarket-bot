DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 可選：填入伺服器 ID 以快速註冊指令；不填則註冊為全域指令。
DISCORD_GUILD_ID=
DISCORD_WALLET_CHANNEL_ID=
ALCHEMY_API_KEY=
DATABASE_URL=

# 活動模組與 /wallet 共用同一個 Bot Client；預設關閉。
ACTIVITY_ENABLED=false
ACTIVITY_SCOPE=test
ACTIVITY_API_ORIGIN=http://127.0.0.1:8789
ACTIVITY_API_TOKEN=
ACTIVITY_GUILD_ID=
ACTIVITY_CHANNEL_ID=
# 必填分類 ID；不以 support 或 📩SUPPORT 等可變名稱判斷。
ACTIVITY_SUPPORT_CATEGORY_ID=
ACTIVITY_MODERATOR_ROLE_ID=
ACTIVITY_PUBLIC_ORIGIN=http://127.0.0.1:5173
# 正式環境須指向持久磁碟；不可與其他 instance 共寫同一 journal。
ACTIVITY_JOURNAL_PATH=.local/activity-outbox.ndjson
